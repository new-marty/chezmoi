# Shell options
unsetopt correct correctall
DISABLE_CORRECTION="true"
setopt auto_pushd auto_cd

# Completion settings (cached for faster startup)
autoload -U compinit
zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ -s "$zcompdump" && "$zcompdump" -nt "${ZDOTDIR:-$HOME}/.zshrc" ]]; then
  compinit -C  # Use cached completions
else
  compinit       # Rebuild cache if missing or stale
fi
unset zcompdump
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:default' menu select=1

# History settings
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000
setopt share_history hist_ignore_dups hist_ignore_all_dups hist_ignore_space hist_reduce_blanks

# Tool configurations (only if installed)
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
autoload -U +X bashcompinit && bashcompinit

# thefuck - command correction
command -v thefuck &>/dev/null && eval "$(thefuck --alias)"

# mise - unified runtime version manager (use shims for faster startup)
command -v mise &>/dev/null && eval "$(mise activate zsh --shims)"

# atuin - enhanced history (disable up arrow override for cleaner keybindings)
command -v atuin &>/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# zoxide - smarter cd
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# direnv - per-directory environment
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# navi - cheat sheets
command -v navi &>/dev/null && eval "$(navi widget zsh)"

# Load Sheldon with caching for faster startup
# (plugins are managed via ~/.config/sheldon/plugins.toml). Without sheldon,
# source the local files directly so the aliases and widgets still load.
if command -v sheldon &>/dev/null; then
  cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}
  sheldon_cache="$cache_dir/sheldon.zsh"
  sheldon_toml="$HOME/.config/sheldon/plugins.toml"

  if [[ ! -r "$sheldon_cache" || "$sheldon_toml" -nt "$sheldon_cache" ]]; then
    mkdir -p "$cache_dir"
    sheldon source > "$sheldon_cache"
  fi
  source "$sheldon_cache"
  unset cache_dir sheldon_cache sheldon_toml
else
  for f in ~/.zsh/*.zsh(N) ~/.zsh/*.zsh-theme(N); do source "$f"; done
  unset f
fi

# Custom key bindings (after sheldon loading)
# Note: atuin uses --disable-up-arrow so up/down arrows work normally
bindkey '^R' peco-select-history  # Ctrl+R: peco history search
(( $+widgets[_atuin_search_widget] )) && bindkey '^H' _atuin_search_widget # Ctrl+H: atuin enhanced history search

# Ensure suggestion widgets work properly (after all other bindings)
bindkey '^G' show_command_templates # Ctrl+G for command templates
bindkey '^S' smart_command_suggest  # Ctrl+S for smart suggestions
bindkey '^F' show_frequent_commands # Ctrl+F for frequent commands
bindkey '^N' navi_widget            # Ctrl+N for navi cheat sheets

# Machine-local aliases and functions (not managed by chezmoi)
if [[ -f ~/.zshrc.local ]]; then source ~/.zshrc.local; fi
