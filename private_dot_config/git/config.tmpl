# =============================================================================
# Git configuration - managed by chezmoi (~/.config/git/config)
# =============================================================================
# Shared settings only. Identity, signing and other machine-local settings go
# in ~/.gitconfig, which chezmoi creates once (holding only a comment) and never
# touches again.
# git reads ~/.gitconfig after this file, so its values win, and
# `git config --global` writes there too.
#
# Tools that may be missing (Cursor, VS Code, delta) are only configured when
# chezmoi finds them at apply time; run `chezmoi apply` again after installing.

[core]
{{- /* Same choice as the `c` alias in dot_zshenv.tmpl: Cursor when it is
       opted in and installed, otherwise VS Code when installed. */}}
{{- $optin := dig "optin" list . }}
{{- if and (has "cursor" $optin) (lookPath "cursor") }}
    editor = cursor --wait
{{- else if lookPath "code" }}
    editor = code --wait
{{- end }}
    autocrlf = input
    pager = less -FRX
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[commit]
    verbose = true         # Show diff in commit message editor

[merge]
    conflictstyle = diff3
    tool = nvimdiff

[diff]
    colorMoved = default
{{- if lookPath "delta" }}
    tool = delta

[interactive]
    diffFilter = delta --color-only

[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula
{{- end }}

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[alias]
    # Shortcuts
    co = checkout
    ci = commit
    st = status -sb
    br = branch
    df = diff
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

    # Useful commands
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    wip = !git add -A && git commit -m 'WIP'
    please = push --force-with-lease

    # Show all aliases
    aliases = config --get-regexp alias

    # Clean merged branches
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

{{ if eq .chezmoi.os "darwin" }}
[credential]
    helper = osxkeychain
{{ else if eq .chezmoi.os "linux" }}
[credential]
    helper = store
{{ end }}
