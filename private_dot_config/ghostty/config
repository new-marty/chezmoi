shell-integration = zsh

font-family = "Hack Nerd Font Mono Regular"
font-size = 12
font-feature = -calt
font-feature = -liga
font-feature = -dlig

theme = poimandres.ghostty
background-opacity = 0.8

# Terminal behavior optimizations for steeef theme
cursor-style = block
cursor-style-blink = false
scrollback-limit = 104857600

# Window and display settings
macos-titlebar-style = tabs
macos-non-native-fullscreen = visible-menu
window-height = 9999999
window-width = 9999999

# Quick terminal settings
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-animation-duration = 0
quick-terminal-autohide = false

# Key bindings
keybind = "global:f2=toggle_quick_terminal"
keybind = shift+enter=text:\n

# Enhanced terminal features for development
mouse-hide-while-typing = true
copy-on-select = true
confirm-close-surface = false

# Font rendering optimizations
font-thicken = true
