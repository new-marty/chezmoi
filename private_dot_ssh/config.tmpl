# =============================================================================
# SSH Configuration - Generated by chezmoi
# Machine: {{ .chezmoi.hostname }}
# =============================================================================

{{- if .is_personal_mac }}
# --- OrbStack SSH Configuration ---
# Keep existing OrbStack integration for personal Mac
Include ~/.orbstack/ssh/config

{{- end }}

# --- 1Password SSH Agent (All Hosts) ---
Host *
    # 1Password SSH Agent socket (macOS-specific path)
    # Note: For Linux/Windows support, this path would need to be OS-conditional
    IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

    # Connection stability
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Performance optimizations
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # 1Password Agent handles key management
    # AddKeysToAgent no
    # UseKeychain no

# --- GitHub Configuration ---
{{- if .is_personal_mac }}
# Personal Mac: Direct github.com access
Host github.com
    HostName github.com
    User git
{{- end }}

{{- if .is_work_mac }}
# Work Mac: Separate hosts for personal and work GitHub
Host github.com-personal
    HostName github.com
    User git

Host github.com-work
    HostName github.com
    User git
{{- end }}

{{- if .is_personal_mac }}
# --- Personal Server Configurations ---
# Note: Currently using legacy RSA keys. Consider migrating to Ed25519 in the future:
# ssh-keygen -t ed25519 -C "server-2025" -f ~/.ssh/id_ed25519_server
Host debian
    HostName 192.0.2.11
    User server

Host unraid
    HostName 192.0.2.10
    Port 22
    User root
{{- end }}
