# =============================================================================
# SSH Configuration - Generated by chezmoi
# Machine: {{ .chezmoi.hostname }}
# =============================================================================

{{- if .is_personal_mac }}
# --- OrbStack SSH Configuration ---
# Keep existing OrbStack integration for personal Mac
Include ~/.orbstack/ssh/config

{{- end }}

# --- SSH Agent Configuration (All Hosts) ---
Host *
{{- if eq .chezmoi.os "darwin" }}
    # 1Password SSH Agent socket (macOS)
    IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
{{- else if eq .chezmoi.os "linux" }}
    # 1Password SSH Agent socket (Linux)
    IdentityAgent ~/.1password/agent.sock
{{- end }}

    # Connection stability
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Performance optimizations
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

# --- GitHub Configuration ---
{{- if .is_personal_mac }}
# Personal Mac: Direct github.com access
Host github.com
    HostName github.com
    User git
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519_macbook
    IdentityAgent none
{{- end }}

{{- if .is_work_mac }}
# Work Mac: Separate hosts for personal and work GitHub
Host github.com-personal
    HostName github.com
    User git

Host github.com-work
    HostName github.com
    User git
{{- end }}

{{- if .is_ubuntu }}
# Ubuntu: GitHub via 1Password SSH Agent
Host github.com
    HostName github.com
    User git
{{- end }}

{{- if .is_personal_mac }}
# --- Personal Server Configurations ---
# Keys managed by 1Password SSH Agent (Ed25519)
Host debian
    HostName 192.0.2.11
    User server

Host unraid
    HostName 100.64.0.10
    User root

Host mac-mini
    HostName 100.64.0.11
    User mac-mini
{{- end }}
