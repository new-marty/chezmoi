# =============================================================================
# SSH Configuration - Generated by chezmoi
# Machine: {{ .chezmoi.hostname }}
# =============================================================================

# --- OrbStack SSH Configuration ---
# Keep existing OrbStack integration
Include ~/.orbstack/ssh/config

# --- 1Password SSH Agent (All Hosts) ---
Host *
    # 1Password SSH Agent socket
    IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

    # Connection stability
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Performance optimizations
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # 1Password Agent handles key management
    # AddKeysToAgent no
    # UseKeychain no

# --- GitHub Configuration ---
{{- if .is_personal_mac }}
# Personal Mac: Direct github.com access
Host github.com
    HostName github.com
    User git
{{- end }}

{{- if .is_work_mac }}
# Work Mac: Separate hosts for personal and work GitHub
Host github.com-personal
    HostName github.com
    User git

Host github.com-work
    HostName github.com
    User git
{{- end }}

# --- Existing Server Configurations ---
Host debian
    HostName 192.0.2.10
    User server
    IdentityFile ~/.ssh/id_rsa

Host unraid
    HostName unraid.example.com
    Port 22
    User root
    IdentityFile ~/.ssh/id_rsa
