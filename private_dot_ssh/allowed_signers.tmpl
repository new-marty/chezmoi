# =============================================================================
# SSH Allowed Signers for Git Commit Verification
# Generated by chezmoi - Machine: {{ .chezmoi.hostname }}
# =============================================================================
# 
# This file lists trusted SSH keys for verifying Git commit signatures.
# Format: email key-type public-key [comment]
# 
# After generating SSH keys on each machine, add the public keys here:
# 1. Generate key: ssh-keygen -t ed25519 -C "MACHINE-2025" -f ~/.ssh/id_ed25519_MACHINE
# 2. Get public key: cat ~/.ssh/id_ed25519_MACHINE.pub
# 3. Add to chezmoi config (see instructions below)
# 
# Configuration in ~/.config/chezmoi/chezmoi.toml:
# [data]
#     ssh_public_keys = [
#         "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... macbook",
#         "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5BBBB... work",
#     ]
#
{{- if .git_email }}
{{- if .ssh_public_keys }}
{{- range .ssh_public_keys }}
{{ $.git_email }} {{ . }}
{{- end }}
{{- else }}
# No SSH public keys configured yet.
# Add your keys to ~/.config/chezmoi/chezmoi.toml
#
# Example:
# {{ .git_email }} ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPuxMQ4cfi4woqUlm0izdYBW5ObMxVvX5dfxaMIMRrig macbook
{{- end }}
{{- else }}
# Configure git_email in ~/.config/chezmoi/chezmoi.toml first
{{- end }}
