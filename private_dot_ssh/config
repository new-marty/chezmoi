# =============================================================================
# SSH configuration - managed by chezmoi
# =============================================================================
# Hosts, keys and the agent differ per machine, so they live in
# ~/.ssh/config.local, which chezmoi does not manage. It is included first
# because ssh uses the first value it finds for each option: anything set
# there overrides the defaults below. A missing file is ignored.
Include ~/.ssh/config.local

Host *
    # Keep idle connections alive through NAT and firewalls
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Reuse one connection per host (sockets directory: ~/.ssh/sockets)
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m
