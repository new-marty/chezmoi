#
# Environment Variables Configuration
# This file is always sourced, for all shells
#

# Basic environment variables
export LANG='en_US.UTF-8'
export EDITOR='nano'
export VISUAL='nano'
export PAGER='less'
{{ if eq .chezmoi.os "darwin" -}}
export BROWSER='open'
{{ else if eq .chezmoi.os "linux" -}}
export BROWSER='xdg-open'
{{ end -}}

# Less configuration
export LESS='-R'
{{ if eq .chezmoi.os "darwin" -}}
[[ -x /opt/homebrew/bin/src-hilite-lesspipe.sh ]] && export LESSOPEN='| /opt/homebrew/bin/src-hilite-lesspipe.sh %s'
{{ else if eq .chezmoi.os "linux" -}}
[[ -x /home/linuxbrew/.linuxbrew/bin/src-hilite-lesspipe.sh ]] && export LESSOPEN='| /home/linuxbrew/.linuxbrew/bin/src-hilite-lesspipe.sh %s'
{{ end -}}

# Application configurations
{{ if eq .chezmoi.os "darwin" -}}
export GOOGLE_CHROME_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
{{ end -}}

# Homebrew - ensure commands are available in non-interactive shells
# (Primary setup is in .zprofile for interactive shells)
{{ if eq .chezmoi.os "darwin" -}}
[[ -z "$HOMEBREW_PREFIX" && -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else if eq .chezmoi.os "linux" -}}
[[ -z "$HOMEBREW_PREFIX" && -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}

# Development languages managed by mise (in .zshrc)
# mise handles: node, python, ruby, rust, go, java, etc.
# Run 'mise ls' to see installed versions, 'mise use node@20' to set version

# Development tools and utilities
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{ else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end -}}
export PATH="$PNPM_HOME:$PATH"

# GUI editor for the `c` alias (alias.zsh). chezmoi picks it when it renders
# this file, the same way it picks git's core.editor: Cursor when "cursor" is in
# the machine's opt-in list and installed, otherwise VS Code when installed.
# A plain shell variable, not exported, so child processes do not see it.
# Override it in ~/.zshenv.local, or redefine `c` in ~/.zshrc.local.
{{- $optin := dig "optin" list . }}
{{- if and (has "cursor" $optin) (lookPath "cursor") }}
DOTFILES_GUI_EDITOR='cursor'
{{- else if lookPath "code" }}
DOTFILES_GUI_EDITOR='code'
{{- else }}
DOTFILES_GUI_EDITOR=''
{{- end }}

# Machine profile (.chezmoidata/profiles.toml), for .zshrc to pick the plugin
# loader: "work" loads Oh My Zsh, "full" loads sheldon. A plain shell variable,
# like DOTFILES_GUI_EDITOR.
DOTFILES_PROFILE='{{ dig "profile" "full" . }}'

# Machine-local environment (not managed by chezmoi)
[[ -f "$HOME/.zshenv.local" ]] && source "$HOME/.zshenv.local"

# Remove duplicate entries from PATH
typeset -U path
