#
# Environment Variables Configuration
# This file is always sourced, for all shells
#

# Basic environment variables
export LANG='en_US.UTF-8'
export EDITOR='nano'
export VISUAL='nano'
export PAGER='less'
[[ "$OSTYPE" == darwin* ]] && export BROWSER='open'

# Load secrets if the file exists
[[ -f "$HOME/.secrets" ]] && source "$HOME/.secrets"

# Less configuration
export LESS='-R'
export LESSOPEN='| /opt/homebrew/bin/src-hilite-lesspipe.sh %s'

# Application configurations
export GOOGLE_CHROME_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'

# Homebrew - ensure commands are available in non-interactive shells
# (Primary setup is in .zprofile for interactive shells)
[[ -z "$HOMEBREW_PREFIX" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# Development languages
# Note: mise (in .zshrc) is the primary runtime manager for Node.js, Python, etc.
# NVM below is kept for legacy compatibility and will only load if mise is not managing Node.
export NVM_DIR="$HOME/.nvm"
# Lazy load nvm - it will be loaded on first use (if mise doesn't provide node)
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # Add nvm's default node to PATH immediately (if exists)
    [[ -d "$NVM_DIR/versions/node" ]] && \
        export PATH="$NVM_DIR/versions/node/$(ls -1 $NVM_DIR/versions/node 2>/dev/null | tail -1)/bin:$PATH"

    # Define lazy loading functions
    nvm() {
        unset -f nvm node npm npx
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
        nvm "$@"
    }
    node() {
        unset -f nvm node npm npx
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        node "$@"
    }
    npm() {
        unset -f nvm node npm npx
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        npm "$@"
    }
    npx() {
        unset -f nvm node npm npx
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        npx "$@"
    }
fi

# .NET
export PATH="/opt/homebrew/opt/dotnet@6/bin:$PATH"

# Additional language tools
export PATH="/opt/homebrew/lib/python3.12/site-packages/pip:$PATH"
export PATH="/usr/local/texlive/2022/bin/universal-darwin:$PATH"
export PATH="/opt/homebrew/opt/mongodb-community@4.2/bin:$PATH"
export PATH="/usr/local/opt/php/bin:$PATH"

# Development tools and utilities
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.amplify/bin:$PATH"
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"
export PATH="$HOME/.console-ninja/.bin:$PATH"

# Remove duplicate entries from PATH
typeset -U path
