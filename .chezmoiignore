{{- /*
Opt-in application settings. .chezmoidata/optin.toml maps each switch to the
files, directories and scripts it controls; the machine selects switches with
`optin = [...]` under [data] in its chezmoi.toml. `dig` returns an empty list when the key is
missing, so a machine with no config gets only the core. Paths of switches
that are not selected are ignored here, which means chezmoi leaves an
existing file in place and stops managing it; it never deletes it.
*/}}
{{- $optin := dig "optin" list . }}
{{- if not (kindIs "slice" $optin) }}
{{-   fail "chezmoi.toml: data.optin must be a list of names, e.g. optin = [\"vscode\"]" }}
{{- end }}
{{- range $optin }}
{{-   if not (hasKey $.optin_paths .) }}
{{-     fail (printf "chezmoi.toml: unknown opt-in %q in data.optin; valid names are in .chezmoidata/optin.toml: %s" . (keys $.optin_paths | sortAlpha | join ", ")) }}
{{-   end }}
{{- end }}
{{- /*
Choices (optin_choices in optin.toml): when a machine selects a switch that
needs a choice, it must also select exactly one of the choice's options. There
is no default; the apply stops until the machine picks one. An option selected
without any switch that needs it would do nothing, so that stops the apply too.
*/}}
{{- range $name, $ch := .optin_choices }}
{{-   $needed := list }}
{{-   range $ch.required_by }}{{ if has . $optin }}{{ $needed = append $needed . }}{{ end }}{{ end }}
{{-   $picked := list }}
{{-   range $ch.options }}{{ if has . $optin }}{{ $picked = append $picked . }}{{ end }}{{ end }}
{{-   if gt (len $picked) 1 }}
{{-     fail (printf "chezmoi.toml: data.optin selects both %s; keep only one (%s)" ($picked | join " and ") $ch.description) }}
{{-   end }}
{{-   if and $picked (not $needed) }}
{{-     fail (printf "chezmoi.toml: data.optin selects %s, which only changes %s; also select %s, or remove it" ($picked | join " and ") ($ch.required_by | join " and ") ($ch.required_by | join " or ")) }}
{{-   end }}
{{-   if and $needed (eq (len $picked) 0) }}
{{-     fail (printf "chezmoi.toml: data.optin selects %s, so it must also select one of %s (%s); there is no default" ($needed | join " and ") ($ch.options | join " or ") $ch.description) }}
{{-   end }}
{{- end }}
# Opt-in paths not selected on this machine
{{- range $name, $sw := .optin_paths }}
{{-   if not (has $name $optin) }}
{{-     range concat (dig "dirs" list $sw) (dig "files" list $sw) (dig "scripts" list $sw) }}
{{ . }}
{{-     end }}
{{-   end }}
{{- end }}
