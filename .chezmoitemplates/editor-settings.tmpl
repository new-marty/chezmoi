{{- /*
How the settings look is the machine's choice, with no default (optin_choices
in .chezmoidata/optin.toml; .chezmoiignore stops the apply without one):
editor-extensions uses the Poimandres and catppuccin extensions and Hack Nerd
Font; editor-builtin, for a Mac that cannot install extensions or fonts,
colours the built-in Default Dark Modern theme with the Poimandres colours (the
same as private_dot_config/ghostty/themes/poimandres.ghostty) and uses system
fonts.
*/ -}}
{{- $optin := dig "optin" list . -}}
{{- $builtin := has "editor-builtin" $optin -}}
{{- if not (or $builtin (has "editor-extensions" $optin)) -}}
{{-   fail "chezmoi.toml: data.optin must select editor-extensions or editor-builtin for the VS Code and Cursor settings" -}}
{{- end -}}
{
  // =============================================================================
  // Editor Settings - shared by VS Code and Cursor (.chezmoitemplates/editor-settings.tmpl)
  // Machine: {{ .chezmoi.hostname }}
  // Generated by chezmoi
  // =============================================================================

  // Language-specific Settings
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[python]": {
    "editor.formatOnType": true,
  },
  "[sql]": {
    "editor.formatOnSave": false,
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Claude Code extension: open in the panel, not the sidebar
  "claudeCode.preferredLocation": "panel",

  // Editor Settings
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.codeActionsOnSave": {},
{{- if $builtin }}
  "editor.fontFamily": "SF Mono, Menlo, Monaco, monospace",
{{- else }}
  "editor.fontFamily": "Hack Nerd",
{{- end }}
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "editor.largeFileOptimizations": false,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "alt",
  "editor.stickyScroll.enabled": true,
  "editor.suggestSelection": "first",
{{- if $builtin }}
  // Default Dark Modern colours semantic tokens with its own palette, which
  // would override the Poimandres token colours below.
  "editor.semanticTokenColorCustomizations": {
    "[Default Dark Modern]": {
      "enabled": false
    }
  },
{{- end }}
  "editor.tokenColorCustomizations": {
{{- if $builtin }}
    "[Default Dark Modern]": {
      "textMateRules": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#767c9d", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage", "storage.type", "keyword.operator"], "settings": { "foreground": "#91b4d5" } },
        { "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#5de4c7" } },
        { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#5de4c7" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#add7ff" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#91b4d5" } },
        { "scope": ["variable", "variable.parameter", "meta.object-literal.key"], "settings": { "foreground": "#e4f0fb" } },
        { "scope": ["entity.name.tag"], "settings": { "foreground": "#5de4c7" } },
        { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#91b4d5" } },
        { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#a6accd" } },
        { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#5de4c7", "fontStyle": "bold" } },
        { "scope": ["invalid"], "settings": { "foreground": "#d0679d" } }
      ]
    },
{{- end }}
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "textMateRules": [
      {
        "scope": "keyword.other.dotenv",
        "settings": {
          "foreground": "#FF000000"
        }
      }
    ]
  },

  // Emmet Settings
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,

  // Explorer Settings
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.sortOrder": "type",

  // Files Settings
  "files.associations": {
    "*.css": "tailwindcss",
    ".env*": "dotenv"
  },
  "files.watcherExclude": {
    "**/.ammonite": true,
    "**/.bloop": true,
    "**/.metals": true,
  },

  // Git Settings
  "git.openRepositoryInParentFolders": "always",
  "githubPullRequests.pullBranch": "never",

  // JavaScript/TypeScript Settings
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "never",

  // Makefile Settings
  "makefile.configureOnOpen": true,

  // Python Settings
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",

  // Telemetry Settings
  "redhat.telemetry.enabled": false,

  // Terminal Settings
  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1",
    "Q_NEW_SESSION": "1",
  },
{{- if $builtin }}
  "terminal.integrated.fontFamily": "SF Mono, Menlo, Monaco, monospace",
{{- end }}

  // Window Settings
  "window.zoomLevel": -1,

  // Workbench Settings
  "workbench.activityBar.orientation": "vertical",
{{- if $builtin }}
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "focusBorder": "#00000000",
      "activityBar.background": "#1b1e28",
      "activityBar.foreground": "#a6accd",
      "activityBar.border": "#00000000",
      "activityBarBadge.background": "#303340",
      "activityBarBadge.foreground": "#e4f0fb",
      "badge.background": "#303340",
      "badge.foreground": "#e4f0fb",
      "button.background": "#303340",
      "button.foreground": "#ffffff",
      "dropdown.background": "#1b1e28",
      "editor.background": "#1b1e28",
      "editor.foreground": "#a6accd",
      "editor.findMatchBackground": "#add7ff40",
      "editor.lineHighlightBackground": "#717cb425",
      "editor.selectionBackground": "#717cb425",
      "editorCursor.foreground": "#a6accd",
      "editorGroup.border": "#00000030",
      "editorGroupHeader.tabsBackground": "#1b1e28",
      "editorGutter.background": "#1b1e28",
      "editorLineNumber.activeForeground": "#a6accd",
      "editorLineNumber.foreground": "#767c9d50",
      "editorWidget.background": "#1b1e28",
      "input.background": "#ffffff05",
      "list.activeSelectionBackground": "#30334080",
      "list.hoverBackground": "#30334080",
      "list.inactiveSelectionBackground": "#30334080",
      "panel.background": "#1b1e28",
      "panel.border": "#00000030",
      "sideBar.background": "#1b1e28",
      "sideBar.border": "#00000030",
      "sideBar.foreground": "#767c9d",
      "sideBarSectionHeader.background": "#1b1e28",
      "statusBar.background": "#1b1e28",
      "statusBar.foreground": "#a6accd",
      "tab.activeBackground": "#30334080",
      "tab.activeForeground": "#e4f0fb",
      "tab.border": "#00000000",
      "tab.inactiveBackground": "#1b1e28",
      "tab.inactiveForeground": "#767c9d",
      "terminal.background": "#1b1e28",
      "terminal.foreground": "#a6accd",
      "terminalCursor.foreground": "#ffb473",
      "terminal.selectionBackground": "#717cb440",
      "terminal.ansiBlack": "#1b1e28",
      "terminal.ansiRed": "#d0679d",
      "terminal.ansiGreen": "#5de4c7",
      "terminal.ansiYellow": "#fffac2",
      "terminal.ansiBlue": "#89ddff",
      "terminal.ansiMagenta": "#fcc5e9",
      "terminal.ansiCyan": "#89ddff",
      "terminal.ansiWhite": "#ffffff",
      "terminal.ansiBrightBlack": "#a6accd",
      "terminal.ansiBrightRed": "#d0679d",
      "terminal.ansiBrightGreen": "#5de4c7",
      "terminal.ansiBrightYellow": "#fffac2",
      "terminal.ansiBrightBlue": "#add7ff",
      "terminal.ansiBrightMagenta": "#fcc5e9",
      "terminal.ansiBrightCyan": "#add7ff",
      "terminal.ansiBrightWhite": "#ffffff",
      "titleBar.activeBackground": "#1b1e28",
      "titleBar.activeForeground": "#a6accd",
      "titleBar.inactiveBackground": "#1b1e28",
      "titleBar.border": "#00000030"
    }
  },
  "workbench.colorTheme": "Default Dark Modern",
{{- else }}
  "workbench.colorTheme": "Poimandres Dark Enhanced",
  "workbench.iconTheme": "catppuccin-mocha",
{{- end }}
  "workbench.statusBar.visible": false,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],