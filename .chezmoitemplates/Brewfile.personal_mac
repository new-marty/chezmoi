# VSCode Extensions - Personal only
cask "openclaw"
cask "cmux"
cask "meetily"
cask "stablyai/orca/orca"          # Third-party tap; needs `brew trust --cask` for both orca and orca@rc
cask "antigravity-cli"

# makemkv is managed manually, not by Homebrew. The vendor ships an
# ad-hoc-signed, un-notarized app, so it fails Gatekeeper; Homebrew disabled the
# cask on 2026-09-01 for that reason and there is no sign the vendor will sign
# it. Download from https://www.makemkv.com/download/ instead.

