# =============================================================================
# Personal Mac Packages
#
# One file per machine: there is no shared "common" list. To pull entries from
# another machine's list, run `just brew-pick <machine>`.
# =============================================================================

# --- Essentials -------------------------------------------------------------
# Required by the dotfiles themselves: the shell startup files source these,
# gitconfig uses delta as its pager, and run_once_before_install-tpm needs tmux.
# A machine without them has a broken prompt, so install these first.
brew "chezmoi"
brew "git"
brew "git-delta"
brew "mise"
brew "sheldon"
brew "just"
brew "tmux"
brew "fzf"
brew "peco"
brew "navi"
brew "atuin"
brew "zoxide"
brew "direnv"
brew "bat"
brew "eza"
brew "fd"
brew "ripgrep"
brew "jq"
brew "gh"
brew "thefuck"

# --- Core CLI Tools ---
brew "curl"
brew "tree"
brew "glow"              # Render markdown in terminal
brew "doggo"             # Modern DNS lookup (dig replacement)
brew "bandwhich"         # Bandwidth monitor by process
brew "gping"             # Ping with graph

# --- Shell & Terminal ---
brew "sesh"               # Smart tmux session manager (integrates with zoxide/fzf)

# --- Version Control ---
brew "lazygit"           # Terminal UI for git
brew "gitleaks"          # Secret scanning for git repos

# --- Build Tools & Task Runners ---
brew "autoconf"
brew "gcc"
brew "pkgconf"

# --- Cloud & DevOps ---
brew "flyctl"

# --- Package Managers ---
brew "composer"
brew "yarn"
brew "uv"

# --- Network Tools ---
brew "aria2"
brew "nmap"
brew "nghttp2"
brew "openconnect"
brew "openvpn"
brew "xh"                # Friendly HTTP client (httpie alternative)

# --- Security ---
brew "age"
brew "openssl@3"

# --- Text Processing ---
brew "pandoc"
brew "prettier"

# --- Media & Entertainment ---
brew "ffmpeg"           # Latest version
brew "gifski"
brew "imagemagick"
brew "yt-dlp"

# --- Development - Personal Projects ---
brew "ollama"
brew "sbt"
brew "swiftformat"
brew "swiftlint"
brew "xcbeautify"
brew "xcode-build-server"
brew "xcodegen"

# --- Utilities ---
brew "bento4"
brew "cabextract"
brew "cdrtools"
brew "cloc"
brew "ghostscript"
brew "graphviz"

# --- Utilities ---
brew "wimlib"

# --- Development ---
brew "sqlc"
brew "go-task"
brew "playwright-cli"
brew "openclaw-cli"
brew "handbrake"

