# =============================================================================
# Common Packages - Shared across all machines
# =============================================================================

# Taps
tap "mongodb/brew"
tap "stripe/stripe-cli"

# Core CLI Tools
brew "chezmoi"
brew "bat"
brew "git-delta"
brew "ccat"
brew "curl"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "jq"
brew "navi"
brew "peco"
brew "ripgrep"
brew "sheldon"
brew "thefuck"
brew "tree"
brew "zoxide"
brew "atuin"
brew "tldr"              # Simplified man pages
brew "dust"              # Better du (disk usage)
brew "duf"               # Better df (disk free)
brew "procs"             # Better ps (process viewer)
brew "bottom"            # Better top/htop
brew "lazygit"           # TUI for git
brew "httpie"            # Better curl for APIs
brew "direnv"            # Per-directory environment variables

# Shell & Terminal
brew "zsh"

# Version Control
brew "git"

# Programming Languages & Runtimes
# Using mise (formerly rtx) for unified version management
# Replaces: nvm, pyenv, pyenv-virtualenv, rustup
brew "mise"
brew "go"
# Note: node, python, rust are managed by mise - see ~/.config/mise/config.toml

# Build Tools
brew "autoconf"
brew "gcc"
brew "pkgconf"

# Cloud & DevOps
brew "awscli"
brew "aws-sso-cli"
brew "terraform"
brew "flyctl"

# Containers
brew "docker", link: false
brew "docker-compose"

# Databases
brew "mysql"
brew "postgresql@14"
brew "mongosh"

# Package Managers
brew "composer"
brew "yarn"
brew "uv"

# Network Tools
brew "aria2"
brew "nmap"
brew "nghttp2"
brew "openconnect"
brew "openvpn"
brew "dog"               # Modern DNS lookup (dig replacement)
brew "bandwhich"         # Realtime bandwidth monitor by process
brew "gping"             # Visual ping with graph

# Security
brew "age"
brew "openssl@3"
brew "gnupg"

# Text Processing
brew "pandoc"
brew "prettier"
brew "glow"              # Markdown renderer for terminal

# Common Casks
cask "1password"
cask "1password-cli"
cask "cursor"
cask "docker-desktop"
cask "ghostty"
cask "google-chrome"
cask "raycast"
cask "rectangle"
cask "slack"
cask "visual-studio-code"
cask "zoom"

# Fonts
cask "font-hack-nerd-font"

# Common VSCode Extensions
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "eamodio.gitlens"
vscode "dbaeumer.vscode-eslint"
vscode "esbenp.prettier-vscode"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "hashicorp.terraform"
vscode "redhat.vscode-yaml"
vscode "ms-azuretools.vscode-docker"
vscode "PKief.material-icon-theme"
vscode "mikestead.dotenv"
vscode "wayou.vscode-todo-highlight"
vscode "naumovs.color-highlight"
vscode "oderwat.indent-rainbow"
