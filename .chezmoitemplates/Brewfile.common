# =============================================================================
# Common Packages - Shared across all machines
# =============================================================================

# Core CLI Tools
brew "chezmoi"
brew "bat"
brew "curl"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "jq"
brew "navi"
brew "peco"
brew "ripgrep"
brew "sheldon"
brew "thefuck"
brew "tree"
brew "zoxide"
brew "atuin"
brew "mise"              # Unified runtime manager (node, python, etc.)
brew "direnv"            # Per-directory environment variables
brew "glow"              # Render markdown in terminal
brew "doggo"             # Modern DNS lookup (dig replacement)
brew "bandwhich"         # Bandwidth monitor by process
brew "gping"             # Ping with graph

# Shell & Terminal
brew "zsh"

# Version Control
brew "git"
brew "delta"             # Beautiful git diff pager
brew "lazygit"           # Terminal UI for git
brew "gitleaks"          # Secret scanning for git repos

# Programming Languages & Runtimes
# Note: mise manages runtime versions (node, python, ruby, rust, go, java, etc.)
# Install languages via: mise use node@20, mise use python@3.12, etc.
# brew "go"           # Managed by mise
# brew "node"         # Managed by mise
# brew "nvm"          # Replaced by mise
# brew "python@3.11"  # Managed by mise
# brew "pyenv"        # Replaced by mise
# brew "pyenv-virtualenv"  # Replaced by mise
# brew "rustup"       # Managed by mise

# Build Tools & Task Runners
brew "autoconf"
brew "gcc"
brew "pkgconf"
brew "just"              # Modern command runner (like make but simpler)

# Cloud & DevOps
brew "awscli"
brew "aws-sso-cli"
brew "terraform"
brew "flyctl"

# Databases
brew "mysql"
brew "postgresql@14"

# Package Managers
brew "composer"
brew "yarn"
brew "uv"

# Network Tools
brew "aria2"
brew "nmap"
brew "nghttp2"
brew "openconnect"
brew "openvpn"
brew "xh"                # Friendly HTTP client (httpie alternative)

# Security
brew "age"
brew "openssl@3"
brew "gnupg"

# Text Processing
brew "pandoc"
brew "prettier"

# Common Casks
cask "1password"
cask "1password-cli"
cask "cursor"
cask "ghostty"
cask "google-chrome"
cask "orbstack"
cask "raycast"
cask "rectangle"
cask "slack"
cask "visual-studio-code"
cask "zoom"

# Fonts
cask "font-hack-nerd-font"

# Common VSCode Extensions
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "eamodio.gitlens"
vscode "dbaeumer.vscode-eslint"
vscode "esbenp.prettier-vscode"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "hashicorp.terraform"
vscode "redhat.vscode-yaml"
vscode "ms-azuretools.vscode-docker"
