# =============================================================================
# Git Configuration - Generated by chezmoi
# Machine: {{ .chezmoi.hostname }}
# =============================================================================

[user]
    # User configuration (set via chezmoi data or local git config)
    # To override for specific repos, use: git config user.email "work@example.com"
{{- if .is_work_mac }}
    # Work Mac - configure in chezmoi.toml: [data] git_work_email = "your.work@company.com"
    # email = {{ .git_work_email | default "your.work@company.com" | quote }}
{{- end }}

[core]
    editor = cursor --wait
    autocrlf = input
    pager = less -FRX
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[alias]
    # Shortcuts
    co = checkout
    ci = commit
    st = status -sb
    br = branch
    df = diff
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

    # Useful commands
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    wip = !git add -A && git commit -m 'WIP'
    please = push --force-with-lease

    # Show all aliases
    aliases = config --get-regexp alias

    # Clean merged branches
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

[credential]
    helper = osxkeychain

{{ if .is_work_mac -}}
# Work-specific settings can be added here
# [includeIf "gitdir:~/work/"]
#     path = ~/.gitconfig-work
{{- end }}

