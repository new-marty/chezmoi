# =============================================================================
# Git Configuration - Generated by chezmoi
# Machine: {{ .chezmoi.hostname }}
# =============================================================================

[user]
    # Configure in ~/.config/chezmoi/chezmoi.toml:
    # [data]
    #   git_name = "Your Name"
    #   git_email = "your@email.com"
    #   ssh_signing_key = "ssh-ed25519 AAAAC3..."
{{- if .git_name }}
    name = {{ .git_name | quote }}
{{- end }}
{{- if .git_email }}
    email = {{ .git_email | quote }}
{{- end }}
{{- if .ssh_signing_key }}
    signingkey = {{ .ssh_signing_key | quote }}
{{- end }}

[core]
    editor = code --wait
    autocrlf = input
    pager = less -FRX
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[rebase]
    autoStash = true

[commit]
    verbose = true         # Show diff in commit message editor
{{- if .ssh_signing_key }}
    gpgsign = true         # Sign commits with SSH key via 1Password
{{- else }}
    gpgsign = false        # Enable by setting ssh_signing_key in chezmoi.toml
{{- end }}

[merge]
    conflictstyle = diff3
    tool = nvimdiff

[diff]
    colorMoved = default
    tool = delta

[interactive]
    diffFilter = delta --color-only

[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = red

[alias]
    # Shortcuts
    co = checkout
    ci = commit
    st = status -sb
    br = branch
    df = diff
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

    # Useful commands
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    wip = !git add -A && git commit -m 'WIP'
    please = push --force-with-lease

    # Show all aliases
    aliases = config --get-regexp alias

    # Clean merged branches
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

{{ if eq .chezmoi.os "darwin" }}
[credential]
    helper = osxkeychain
{{ else if eq .chezmoi.os "linux" }}
[credential]
    helper = store
{{ end }}
# Include work-specific config for work directories
[includeIf "gitdir:{{ .chezmoi.homeDir }}/work/"]
    path = ~/.gitconfig-work

{{ if .is_work_mac -}}
# Work Mac: Additional work-specific overrides
# Create ~/.gitconfig-work with:
# [user]
#     email = "your.work@company.com"
{{- end }}

{{ if .ssh_signing_key }}
# SSH commit signing with 1Password
[gpg]
    format = ssh

[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else if eq .chezmoi.os "linux" }}
    program = "/opt/1Password/op-ssh-sign"
{{- end }}
    allowedSignersFile = ~/.ssh/allowed_signers
{{ end }}
